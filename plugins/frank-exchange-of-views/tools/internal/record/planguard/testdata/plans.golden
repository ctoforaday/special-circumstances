== stmt f2743f0cdeaa
-- SELECT "open_gaps", "closed_gaps" FROM "board_counts"
  CO-ROUTINE board_counts
    MATERIALIZE gap_grade
      CO-ROUTINE graded
        CO-ROUTINE (subquery)
          MERGE (UNION ALL)
            LEFT
              SCAN m
            RIGHT
              SCAN m
              SEARCH a USING INDEX regrade_gap (gap_id=?)
        SCAN (subquery)
      SCAN g
      SEARCH gl USING INDEX sqlite_autoindex_enum_grade_1 (value=?) LEFT-JOIN
      SEARCH gi USING INDEX sqlite_autoindex_enum_grade_1 (value=?) LEFT-JOIN
      SEARCH gs USING INDEX sqlite_autoindex_enum_grade_1 (value=?) LEFT-JOIN
    MATERIALIZE closure
      CO-ROUTINE closure_act
        COMPOUND QUERY
          LEFT-MOST SUBQUERY
            SCAN c
          UNION ALL
            SCAN rd
            SEARCH d USING INDEX sqlite_autoindex_enum_disposition_1 (value=?)
            SEARCH mr USING INTEGER PRIMARY KEY (rowid=?)
            SEARCH mo USING COVERING INDEX sqlite_autoindex_motion_1 (motion_id=?)
            SEARCH md USING INTEGER PRIMARY KEY (rowid=?)
      SCAN closure_act
      USE TEMP B-TREE FOR GROUP BY
    MATERIALIZE latest_remand
      CO-ROUTINE (subquery)
        CO-ROUTINE (subquery)
          CO-ROUTINE remand
            COMPOUND QUERY
              LEFT-MOST SUBQUERY
                SCAN rd
                SEARCH d USING INDEX sqlite_autoindex_enum_disposition_1 (value=?)
                SEARCH mr USING INTEGER PRIMARY KEY (rowid=?)
                SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
                SEARCH mo USING COVERING INDEX sqlite_autoindex_motion_1 (motion_id=?)
                SEARCH md USING INTEGER PRIMARY KEY (rowid=?)
              UNION ALL
                SCAN rp
                SEARCH mr USING INTEGER PRIMARY KEY (rowid=?)
                SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
                SEARCH pg USING INDEX sqlite_autoindex_motion_rule_position_gap_ids_1 (event_id=?)
          SCAN remand
          USE TEMP B-TREE FOR ORDER BY
        SCAN (subquery)
      SCAN (subquery)
    MATERIALIZE unruled_docket
      SCAN md USING COVERING INDEX motion_docket_gap
      SEARCH mo USING INTEGER PRIMARY KEY (rowid=?)
      CORRELATED SCALAR SUBQUERY
        SEARCH mr USING COVERING INDEX motion_rule_motion (motion_id=?)
    MATERIALIZE superseded
      CO-ROUTINE s
        CO-ROUTINE (subquery)
          SCAN mint_supersedes
          USE TEMP B-TREE FOR ORDER BY
        SCAN (subquery)
      SCAN s
      SEARCH m2 USING INTEGER PRIMARY KEY (rowid=?)
    MATERIALIZE computed
      SEARCH computation USING COVERING INDEX computation_answers (answers>?)
    SCAN m USING COVERING INDEX sqlite_autoindex_mint_1
    SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
    BLOOM FILTER ON gg (minted_event=?)
    SEARCH gg USING AUTOMATIC PARTIAL COVERING INDEX (minted_event=?) LEFT-JOIN
    BLOOM FILTER ON c (gap_id=?)
    SEARCH c USING AUTOMATIC COVERING INDEX (gap_id=?) LEFT-JOIN
    BLOOM FILTER ON lr (gap_id=?)
    SEARCH lr USING AUTOMATIC COVERING INDEX (gap_id=?) LEFT-JOIN
    BLOOM FILTER ON ud (gap_id=?)
    SEARCH ud USING AUTOMATIC COVERING INDEX (gap_id=?) LEFT-JOIN
    BLOOM FILTER ON sp (gap_id=?)
    SEARCH sp USING AUTOMATIC COVERING INDEX (gap_id=?) LEFT-JOIN
    BLOOM FILTER ON cp (gap_id=?)
    SEARCH cp USING AUTOMATIC COVERING INDEX (gap_id=?) LEFT-JOIN
    SEARCH um USING INTEGER PRIMARY KEY (rowid=?) LEFT-JOIN
    SCALAR SUBQUERY
      SCAN events USING COVERING INDEX events_sitting
  SCAN board_counts

