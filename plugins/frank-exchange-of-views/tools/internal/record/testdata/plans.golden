== stmt c4eaa3f0f946
-- SELECT e, kind, about, loc FROM ( SELECT "event_id" e, 'finding' kind, ("about_kind" = 'gap' AND "about_ref" = ?2) about, '' loc FROM "finding" WHERE "id" = ?1 UNION ALL SELECT m."event_id", 'gap', ((m."about_kind" = 'gap' AND m."about_ref" = ?2) OR EXISTS (SELECT 1 FROM "mint_supersedes" s WHERE s."event_id" = m."event_id" AND s."value" = ?2)), '' FROM "mint" m WHERE m."gap_id" = ?1 UNION ALL SELECT ea."placed_event", ea."kind", COALESCE(ea."answers" = ?2, 0), COALESCE(c."location", '') FROM "evidence_anchor" ea LEFT JOIN "cite" c ON c."event_id" = ea."placed_event" WHERE ea."anchor_id" = ?1) ORDER BY e LIMIT 1
  CO-ROUTINE (subquery)
    COMPOUND QUERY
      LEFT-MOST SUBQUERY
        SEARCH finding USING INDEX sqlite_autoindex_finding_1 (id=?)
      UNION ALL
        SEARCH m USING INDEX sqlite_autoindex_mint_1 (gap_id=?)
        CORRELATED SCALAR SUBQUERY
          SEARCH s USING COVERING INDEX mint_supersedes_value (value=? AND event_id=?)
      UNION ALL
        COMPOUND QUERY
          LEFT-MOST SUBQUERY
            SEARCH x USING INDEX sqlite_autoindex_cite_1 (label=?)
            SEARCH c USING INTEGER PRIMARY KEY (rowid=?) LEFT-JOIN
          UNION ALL
            SEARCH x USING INDEX sqlite_autoindex_computation_1 (computation_id=?)
            SEARCH c USING INTEGER PRIMARY KEY (rowid=?) LEFT-JOIN
  SCAN (subquery)
  USE TEMP B-TREE FOR ORDER BY

