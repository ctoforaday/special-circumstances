-- SELECT "agent_id","seat_id","agent_type","turns","thinking_turns","tool_turns", "input_tokens","output_tokens","cache_read","cache_creation","wall_ms","acts" FROM "seat_metrics" ORDER BY COALESCE("seat_id", ''), "agent_id"
  CO-ROUTINE seat_metrics
    MATERIALIZE seat_of_agent
      CO-ROUTINE agent_binding
        COMPOUND QUERY
          LEFT-MOST SUBQUERY
            SCAN r
            CORRELATED SCALAR SUBQUERY
              SEARCH r2 USING COVERING INDEX register_agent (agent_id=?)
            SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
          UNION ALL
            SCAN o
            CORRELATED SCALAR SUBQUERY
              SEARCH r2 USING COVERING INDEX register_agent (agent_id=?)
            CORRELATED SCALAR SUBQUERY
              SEARCH o2 USING COVERING INDEX sitting_open_agent (agent_id=?)
      SCAN b
      SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
    SCAN t USING INDEX seat_turn_agent
    BLOOM FILTER ON s (agent_id=?)
    SEARCH s USING AUTOMATIC COVERING INDEX (agent_id=?) LEFT-JOIN
    CORRELATED SCALAR SUBQUERY
      SEARCH ew USING INDEX events_seat (seat_id=?)
  SCAN seat_metrics
  USE TEMP B-TREE FOR ORDER BY

