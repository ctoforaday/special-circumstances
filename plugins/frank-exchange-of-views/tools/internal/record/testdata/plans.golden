-- SELECT "agent_id", "bucket", "turns", "span_ms", "output_tokens" FROM "seat_time_decomposition" ORDER BY "agent_id", "bucket"
  CO-ROUTINE seat_time_decomposition
    CO-ROUTINE seat_turn_span
      CO-ROUTINE (subquery)
        SCAN seat_turn USING INDEX sqlite_autoindex_seat_turn_1
      SCAN (subquery)
    SCAN seat_turn_span
    USE TEMP B-TREE FOR GROUP BY
  SCAN seat_time_decomposition
  USE TEMP B-TREE FOR ORDER BY

== stmt 386256b2ad3d
-- SELECT "agent_id", "model", min("turn_idx") FROM "seat_turn" WHERE "model" <> '' GROUP BY "agent_id"
  SCAN seat_turn USING INDEX seat_turn_agent

== stmt 59afce1d59e0
-- SELECT "agent_id", "seat_id", "registered_epoch", "sitting", COALESCE("occasion", '') FROM "seat_of_agent"
  CO-ROUTINE agent_binding
    COMPOUND QUERY
      LEFT-MOST SUBQUERY
        SCAN r
        CORRELATED SCALAR SUBQUERY
          SEARCH r2 USING COVERING INDEX register_agent (agent_id=?)
        SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
      UNION ALL
        SCAN o
        CORRELATED SCALAR SUBQUERY
          SEARCH r2 USING COVERING INDEX register_agent (agent_id=?)
        CORRELATED SCALAR SUBQUERY
          SEARCH o2 USING COVERING INDEX sitting_open_agent (agent_id=?)
  SCAN b
  SEARCH e USING INTEGER PRIMARY KEY (rowid=?)

== stmt 504c09adc5c6
-- SELECT "agent_id", "turn_idx", "span_ms", "is_thinking", "is_tool", "output_tokens" FROM "seat_turn_span" ORDER BY "agent_id", "turn_idx"
  CO-ROUTINE seat_turn_span
    CO-ROUTINE (subquery)
      SCAN seat_turn USING INDEX sqlite_autoindex_seat_turn_1
    SCAN (subquery)
  SCAN seat_turn_span
