-- SELECT r."event_id", mr."motion_id", r."disposition", r."settled", COALESCE(r."reopens_on", ''), COALESCE(r."final", 0) FROM "motion_rule_docket" r JOIN "motion_rule" mr ON mr."event_id" = r."event_id" JOIN "motion" mo ON mo."motion_id" = mr."motion_id" JOIN "motion_docket" md ON md."event_id" = mo."event_id" WHERE md."gap_id" = ? ORDER BY r."event_id" DESC LIMIT 1
  SEARCH md USING COVERING INDEX motion_docket_gap (gap_id=?)
  SEARCH mo USING INTEGER PRIMARY KEY (rowid=?)
  SEARCH mr USING COVERING INDEX motion_rule_motion (motion_id=?)
  SEARCH r USING INTEGER PRIMARY KEY (rowid=?)
  USE TEMP B-TREE FOR ORDER BY

== stmt d25a76648285
-- SELECT r."event_id", r."claim", r."reason", r."claim_kept" FROM "retire_anchors" ra JOIN "retire" r ON r."event_id" = ra."event_id" WHERE ra."value" = ? ORDER BY r."event_id" LIMIT 1
  SEARCH ra USING COVERING INDEX retire_anchors_value (value=?)
  SEARCH r USING INTEGER PRIMARY KEY (rowid=?)
  USE TEMP B-TREE FOR ORDER BY

== stmt 68044d32f65b
-- SELECT r."value", c."epoch", COALESCE(c."seat_id", ''), c."old", c."new" FROM "change" c JOIN "blue_edit_reopened" r ON r."event_id" = c."event_id" ORDER BY c."event_id"
  CO-ROUTINE x
    COMPOUND QUERY
      LEFT-MOST SUBQUERY
        SCAN b
      UNION ALL
        SCAN ra USING COVERING INDEX retire_anchors_value
        SEARCH r USING INTEGER PRIMARY KEY (rowid=?)
  SCAN r
  SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
  BLOOM FILTER ON x (event_id=?)
  SEARCH x USING AUTOMATIC COVERING INDEX (event_id=?)
  USE TEMP B-TREE FOR ORDER BY

