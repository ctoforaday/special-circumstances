== view agent_binding
  CO-ROUTINE agent_binding
    COMPOUND QUERY
      LEFT-MOST SUBQUERY
        SCAN r
        CORRELATED SCALAR SUBQUERY
          SEARCH r2 USING COVERING INDEX register_agent (agent_id=?)
        SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
      UNION ALL
        SCAN o
        CORRELATED SCALAR SUBQUERY
          SEARCH r2 USING COVERING INDEX register_agent (agent_id=?)
        CORRELATED SCALAR SUBQUERY
          SEARCH o2 USING COVERING INDEX sitting_open_agent (agent_id=?)
  SCAN agent_binding

== view board_counts
  CO-ROUTINE board_counts
    SCAN gap_state
    SCALAR SUBQUERY
      SCAN events USING COVERING INDEX events_sitting
  SCAN board_counts

== view change
  CO-ROUTINE x
    COMPOUND QUERY
      LEFT-MOST SUBQUERY
        SCAN b
      UNION ALL
        SCAN ra USING COVERING INDEX retire_anchors_value
        SEARCH r USING INTEGER PRIMARY KEY (rowid=?)
  SCAN x
  SEARCH e USING INTEGER PRIMARY KEY (rowid=?)

== view convergence_at
  CO-ROUTINE convergence_at
    CO-ROUTINE (subquery)
      CO-ROUTINE at
        MATERIALIZE point
          MULTI-INDEX OR
            INDEX 1
              SEARCH e USING INDEX events_type (type=?)
            INDEX 2
              SCALAR SUBQUERY
                SEARCH events
              SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
          SCALAR SUBQUERY
            SEARCH events
          SEARCH v USING INTEGER PRIMARY KEY (rowid=?) LEFT-JOIN
        MATERIALIZE board
          MATERIALIZE minted
            SCAN m USING COVERING INDEX mint_key
            SEARCH st USING INTEGER PRIMARY KEY (rowid=?)
            SEARCH e USING INTEGER PRIMARY KEY (rowid=?)
          MATERIALIZE held
            CO-ROUTINE graded
              CO-ROUTINE (subquery)
                MERGE (UNION ALL)
                  LEFT
                    SCAN m
                  RIGHT
                    SCAN m
                    SEARCH a USING INDEX regrade_gap (gap_id=?)
              SCAN (subquery)
            SCAN g
            SEARCH gl USING INDEX sqlite_autoindex_enum_grade_1 (value=?) LEFT-JOIN
            SEARCH gi USING INDEX sqlite_autoindex_enum_grade_1 (value=?) LEFT-JOIN
            SEARCH gs USING INDEX sqlite_autoindex_enum_grade_1 (value=?) LEFT-JOIN
          SCAN p
          SCAN b
          BLOOM FILTER ON h (minted_event=?)
          SEARCH h USING AUTOMATIC COVERING INDEX (minted_event=?)
        SCAN p
        BLOOM FILTER ON w (seq=?)
        SEARCH w USING AUTOMATIC COVERING INDEX (seq=?) LEFT-JOIN
        USE TEMP B-TREE FOR GROUP BY
      SCAN a
      USE TEMP B-TREE FOR ORDER BY
    SCAN (subquery)
  SCAN convergence_at

