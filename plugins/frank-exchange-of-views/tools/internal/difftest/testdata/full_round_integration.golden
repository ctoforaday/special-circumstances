exit 2
stderr:
feov-record: merge: record: dispose --into names gap R1-1, which no mint event created — a dangling reference is accepted here and DROPPED at replay, which is how eight judicial closures vanished from a board that went on reporting them open

$ merge dispose --run {RUN} --seat-id red-merge-r1 --observation L5-N1 --as banked
exit 0
stdout:
disposed L5-N1: banked

$ merge mint --run {RUN} --seat-id red-merge-r1 --class citation-drift --check refetch and diff --severity high --likelihood high --impact high --cx medium --location ## S2 --found-by L1,L5 --problem the cited source does not say this
exit 2
stderr:
feov-record: merge: record: mint --found-by names finding L1, which no lens recorded — attribution to a finding nobody made inflates the lens-sourced count the capture estimate reads

$ merge position --run {RUN} --seat-id red-merge-r1 --text round one: FAIL
exit 0
stdout:
position recorded

$ merge verdict --run {RUN} --seat-id red-merge-r1 --as FAIL
exit 0
